# ── Zetaris (data layer) ─ from your local install; create the API key yourself in the Zetaris web UI
#    Management → API Tokens → "+". The key is shown in plaintext only once.
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=your-zetaris-api-key
ZETARIS_TIMEOUT_S=180   # a 2-table JOIN was measured at 91s; 60 was too low
ZETARIS_QUERY_LIMIT=1000

# ── Meterless Nightshift (primary AI provider) ─ copy URL + Runtime token from Nightshift → Console
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=your-nightshift-runtime-token
METERLESS_APP_ID=hakken-agent           # sent as the meterless-app header on every request
METERLESS_MODEL=meterless/auto          # default route
# Lane pinning is NOT honoured on Runtime m1-m4: every request races six lanes
# under a learned router, and a concrete nvidia/* id is not respected (see
# docs/DECISIONS.md). These dispositions declare our INTENT; the trace records
# the model that actually answered, from meterless.routed_model.
METERLESS_MODEL_FAST=meterless/fast   # Planner/Executor intent
METERLESS_MODEL_DEEP=meterless/deep   # Evaluator/Writer intent
METERLESS_TIMEOUT_S=180                 # contract: cold model loads can take minutes

# ── NVIDIA ─ NOTHING HERE. The NVIDIA API key lives only in Nightshift → Setup → Providers.

# ── PBS public API (reference data, BUILD TIME ONLY -- never called at run time)
# The PBS public API v3 is free and needs no login, but every request needs a
# `subscription-key` header. Replace the placeholder below with the *published
# unregistered* key from the PBS API documentation. It is not a secret; it stays out
# of the repo only because a bare hex string trips the secret scan and looks like a
# committed credential. Rate limit: one request per 20 s, shared by everyone using it, so
# scripts/fetch_reference.py pulls whole tables and never loops per item.
# A free personal key can be registered at data-api-portal.health.gov.au.
PBS_API_BASE=https://data-api.health.gov.au/pbs/api/v3
PBS_SUBSCRIPTION_KEY=your-pbs-public-subscription-key

# ── Runtime behaviour
SAMPLE_MODE=false
DOMAIN_PACK=demo
MAX_AGENT_ITERATIONS=2                  # critique rounds; 3 overran the 10-min run budget live
MAX_RETRIES=2
RUN_TIMEOUT_S=600
STATE_DIR=.state                        # H-MEM + World Model persistence (gitignored)
# Two URLs for one service, because two different callers reach it from two
# different networks. Getting these the wrong way round makes CREATE LIGHTNING
# REST TABLE succeed and then every query against it fail.
#   PUBLIC   = what ZETARIS uses. Goes verbatim into the registration SQL, so it
#              must be reachable from inside the Zetaris containers. Never set
#              this to a name that only resolves on our own compose network.
DATASVC_PUBLIC_URL=http://host.docker.internal:8100
#   INTERNAL = what OUR app uses. localhost when running on the host;
#              http://datasvc:8100 under our docker-compose.
DATASVC_INTERNAL_URL=http://localhost:8100
LOG_LEVEL=INFO
PORT=8000
