# ── Secrets: never commit
.env
.env.*
!.env.example
*.pem
*.key
secrets/
credentials/

# ── Per-machine notes (yours alone; never shared)
CLAUDE.local.md

# ── Reference clones (read-only, not shipped)
.refs/

# ── Runtime state and logs
.state/
logs/*.jsonl
!logs/.gitkeep

# ── Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# ── Node / web
node_modules/
web/dist/

# ── OS
.DS_Store

# ── Generated reference data (regenerate with `make data`; see docs/DATA_LICENCES.md)
data/reference/
